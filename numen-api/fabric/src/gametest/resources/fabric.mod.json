{
    "schemaVersion": 1,
    "id": "numen_gametest",
    "version": "0",
    "name": "Numen API GameTest",
    "description": "Development-only: registers the GameTest suites with Fabric's GameTest API. Never part of the release jar.",
    "environment": "*",
    "mixins": [
        "numen_gametest.mixins.json"
    ],
    "entrypoints": {
        "main": [
            "com.dwinovo.numen.api.gametest.FabricMockConnection"
        ],
        "fabric-gametest": [
            "com.dwinovo.numen.api.gametest.GameTestSuites"
        ]
    },
    "depends": {
        "numen": "*",
        "fabric-gametest-api-v1": "*"
    }
}
